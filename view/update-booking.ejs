<%- include('header') %>

<main class="page-main flex-grow-1 py-4 py-md-5">
  <div class="container booking-container">
    <a href="/bookings/<%= booking.id %>" class="back-link d-inline-block mb-3">&larr; Back to Booking Details</a>
    <h1 class="page-title">Update Booking #<%= booking.id %></h1>
    <p class="page-subtitle mb-4">Modify the details for your upcoming repair service.</p>

    <form action="/bookings/<%= booking.id %>" method="POST">
      <div class="card form-card section-card">
        <div class="card-body p-4">
          <div class="device-info-box mb-4">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-label mb-1">Device Type</div>
                <div class="fw-semibold"><%= booking.deviceType %></div>
              </div>
              <div class="col-md-6">
              <div class="form-label mb-1">Brand &amp; Model</div>
              <div class="fw-semibold"><%= booking.deviceName %></div>
              </div>
            </div>
          </div>

          <h2 class="section-title">Modify Details</h2>
          <div class="mb-3">
            <label for="problemDescription" class="form-label">Problem Description</label>
            <textarea class="form-control" id="problemDescription" name="problemDescription" rows="5" required><%= booking.problemDescription %></textarea>
          </div>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="bookingDate" class="form-label">Booking Date</label>
              <div class="input-icon">
                <i class="bi bi-calendar3"></i>
                <input type="date" class="form-control" id="bookingDate" name="bookingDate" value="<%= booking.date %>" required>
              </div>
            </div>
            <div class="col-md-6">
              <label for="preferredTime" class="form-label">Preferred Time</label>
              <div class="input-icon">
                <i class="bi bi-clock"></i>
                <select class="form-select" id="preferredTime" name="preferredTime" required>
                  <% timeSlots.forEach(function(slot) { %>
                    <option value="<%= slot %>" <%= slot === booking.time ? 'selected' : '' %>><%= slot %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap justify-content-end align-items-center gap-3">
            <a href="/bookings/<%= booking.id %>" class="btn btn-cancel">Cancel</a>
            <button type="submit" form="cancelBookingForm" class="btn btn-cancel-booking" onclick="return confirm('Cancel this booking?');">Cancel Booking</button>
            <button type="submit" class="btn btn-brand">Update Booking</button>
          </div>
        </div>
      </div>
    </form>

    <form id="cancelBookingForm" action="/bookings/<%= booking.id %>/cancel" method="POST" class="d-none"></form>
  </div>
</main>

<%- include('footer') %>
