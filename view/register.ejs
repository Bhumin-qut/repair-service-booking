<%- include('header') %>
<% const form = typeof values !== 'undefined' ? values : {}; %>

<main class="page-main flex-grow-1 py-4 py-md-5">
  <div class="container">
    <div class="card form-card register-card mx-auto">
      <div class="card-body p-4 p-md-5">
        <h1 class="page-title text-center">Create an Account</h1>
        <p class="page-subtitle text-center mb-4">Join Repair Service Booking to start booking and managing your repairs.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>

        <form action="/register" method="POST" class="needs-validation" novalidate>
          <fieldset class="form-fieldset">
            <legend>Account Information</legend>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="johndoe123" value="<%= form.username || '' %>" minlength="3" maxlength="30" pattern="[a-zA-Z0-9._-]+" required>
                <div class="invalid-feedback">Use 3-30 letters, numbers, dots, hyphens, or underscores.</div>
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="john@example.com" value="<%= form.email || '' %>" maxlength="100" required>
                <div class="invalid-feedback">Enter a valid email address.</div>
              </div>
              <div class="col-md-6">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" minlength="8" maxlength="72" data-match-password required>
                <div class="invalid-feedback">Password must be at least 8 characters.</div>
              </div>
              <div class="col-md-6">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="••••••••" minlength="8" maxlength="72" data-match-confirm required>
                <div class="invalid-feedback">Passwords must match.</div>
              </div>
            </div>
          </fieldset>

          <fieldset class="form-fieldset">
            <legend>Personal Details</legend>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="firstName" class="form-label">First Name</label>
                <input type="text" class="form-control" id="firstName" name="firstName" placeholder="John" value="<%= form.firstName || '' %>" minlength="2" maxlength="50" required>
                <div class="invalid-feedback">First name is required.</div>
              </div>
              <div class="col-md-6">
                <label for="lastName" class="form-label">Last Name</label>
                <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Doe" value="<%= form.lastName || '' %>" minlength="2" maxlength="50" required>
                <div class="invalid-feedback">Last name is required.</div>
              </div>
              <div class="col-12">
                <label for="phone" class="form-label">Phone Number</label>
                <input type="tel" class="form-control" id="phone" name="phone" placeholder="(555) 123-4567" value="<%= form.phone || '' %>" pattern="[0-9+()\-\s]{8,20}" required>
                <div class="invalid-feedback">Enter a valid phone number.</div>
              </div>
              <div class="col-12">
                <label for="address" class="form-label">Address</label>
                <textarea class="form-control" id="address" name="address" rows="3" placeholder="123 Main St, City, State, ZIP" minlength="5" maxlength="300" required><%= form.address || '' %></textarea>
                <div class="invalid-feedback">Address is required.</div>
              </div>
            </div>
          </fieldset>

          <div class="text-center mt-2">
            <button type="submit" class="btn btn-brand btn-create">Create Account</button>
            <p class="form-footer-text mt-3 mb-0">
              Already have an account? <a href="/login">Log in</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('footer') %>
